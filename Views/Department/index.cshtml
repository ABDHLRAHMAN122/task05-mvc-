
@{
    ViewData["Title"] = "index";
}

<h1>index</h1>

@model List<Department>

<h2>All Departments</h2>

<a href="/Department/Add">Add New Department</a>

<br />
<br />

<table class="table table-hover table-bordered">
    <thead>
        <tr style=" color: sandybrown">
            <th>Id</th>
            <th>Name</th>
            <th>manager name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr style=" color: white">
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.mgrname</td>
                <td>
                    <a href="/Department/details/@item.Id">Details</a>     |
                    <a href="/Department/DepartmentStudentDetails/@item.Id">Students Filter</a>    |
                    <a href="/Department/Edit/@item.Id">Edit</a>  

                </td>
            </tr>
        }
    </tbody>
</table>